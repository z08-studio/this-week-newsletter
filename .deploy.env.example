# Copy to .deploy.env and keep actual infrastructure details out of Git.
NEWSLETTER_DEPLOY_HOST=your-vultr-ssh-alias
NEWSLETTER_DEPLOY_ROOT=/srv/this-week-newsletter
NEWSLETTER_DOCKER_NETWORK=your-existing-gateway-network
# Used for the one-time HTTPS gateway setup documented in deploy/README.md.
NEWSLETTER_GATEWAY_CONTAINER=your-existing-caddy-container
NEWSLETTER_GATEWAY_CONFIG=/path/to/your/Caddyfile
