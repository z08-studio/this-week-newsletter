---
import type { DesignDirection } from '../data/designDirections';
import DesignReviewNav from '../components/DesignReviewNav.astro';
import '../styles/designs.css';
interface Props { direction?: DesignDirection }
const { direction } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#a52841" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{direction ? `${direction.number} ${direction.name}` : 'Five design directions'} · This Week In Newsletters</title>
    <script is:inline>
      if (new URLSearchParams(location.search).get('embed') === '1') document.documentElement.dataset.embed = 'true';
    </script>
  </head>
  <body class:list={['design-page', { 'design-page--gallery': !direction }]}>
    <a class="design-skip" href="#main">Skip to content</a>
    {direction && <DesignReviewNav direction={direction} />}
    <slot />
  </body>
</html>
