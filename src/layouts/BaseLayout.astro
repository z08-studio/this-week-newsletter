---
import { site } from '../data/site';
import SubmissionLink from '../components/SubmissionLink.astro';
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = `${site.name} — Find your next weekly read`, description = site.description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#a9253b" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="This Week In Newsletters home">
          <img src="/brand-mark.svg" width="64" height="64" alt="" />
          <span class="wordmark-copy"><span>This Week In</span><strong>Newsletters</strong></span>
        </a>
        <SubmissionLink />
      </header>
      <slot />
    </div>
    {!site.submissionFormUrl && (
      <dialog id="submission-dialog" class="submission-dialog" aria-labelledby="submission-title">
        <div class="submission-dialog-content">
          <form method="dialog"><button class="dialog-close" aria-label="Close submission information">×</button></form>
          <img src="/brand-mark.svg" width="48" height="48" alt="" />
          <h2 id="submission-title">A good read deserves company.</h2>
          <p>Our suggestion form is opening soon. We’re making a little room for more great newsletters.</p>
          <form method="dialog"><button class="submit-button">Back to the calendar <span aria-hidden="true">↗</span></button></form>
        </div>
      </dialog>
    )}
  </body>
</html>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#submission-dialog');
  document.querySelectorAll<HTMLButtonElement>('[data-open-submit]').forEach((button) => button.addEventListener('click', () => dialog?.showModal()));
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
</script>
