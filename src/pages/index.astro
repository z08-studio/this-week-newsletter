---
import NewsletterCard from '../components/NewsletterCard.astro';
import { newsletters, weekdays } from '../data/newsletters';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main id="main" class="directory" aria-labelledby="directory-heading">
    <h1 id="directory-heading" class="sr-only">Newsletters by publication day</h1>
    <div class="weekly-calendar">
      {weekdays.map((day, dayIndex) => {
        const entries = newsletters.filter((newsletter) => newsletter.publicationDay === dayIndex);
        return (
          <section class="day-column" data-empty={entries.length === 0 ? 'true' : 'false'} aria-labelledby={`day-${dayIndex}`}>
            <h2 class="day-heading" id={`day-${dayIndex}`}>{day}</h2>
            <ul class="day-newsletters" aria-label={`${day} newsletters`} tabindex={entries.length > 0 ? 0 : undefined}>
              {entries.map((newsletter) => <NewsletterCard newsletter={newsletter} />)}
            </ul>
          </section>
        );
      })}
    </div>
  </main>
</BaseLayout>

<script>
  const entries = Array.from(document.querySelectorAll<HTMLElement>('[data-newsletter]'));
  const hover = window.matchMedia('(hover: hover) and (pointer: fine)');

  for (const entry of entries) {
    const button = entry.querySelector<HTMLButtonElement>('.newsletter-name');
    const preview = entry.querySelector<HTMLElement>('.newsletter-preview');
    if (!button || !preview) continue;
    let closeTimer: ReturnType<typeof setTimeout>;

    function positionPreview() {
      if (!preview?.matches(':popover-open') || !button) return;
      const bounds = button.getBoundingClientRect();
      const width = preview.offsetWidth;
      const height = preview.offsetHeight;
      const left = Math.max(16, Math.min(bounds.left, window.innerWidth - width - 16));
      const below = bounds.bottom + 12;
      const above = bounds.top - height - 12;
      const top = below + height <= window.innerHeight - 16 ? below : Math.max(16, above);
      preview.style.left = `${left}px`;
      preview.style.top = `${top}px`;
    }

    function openPreview() {
      clearTimeout(closeTimer);
      if (!preview?.matches(':popover-open')) preview?.showPopover();
      positionPreview();
    }

    function closePreview() {
      clearTimeout(closeTimer);
      if (preview?.matches(':popover-open')) preview.hidePopover();
    }

    function scheduleClose() {
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => {
        if (!entry.matches(':hover') && !preview?.matches(':hover') && !entry.contains(document.activeElement)) closePreview();
      }, 120);
    }

    entry.addEventListener('pointerenter', (event) => {
      if (hover.matches && event.pointerType === 'mouse') openPreview();
    });
    entry.addEventListener('pointerleave', scheduleClose);
    preview.addEventListener('pointerenter', () => clearTimeout(closeTimer));
    preview.addEventListener('pointerleave', scheduleClose);
    entry.addEventListener('focusout', (event) => {
      if (!entry.contains(event.relatedTarget as Node | null)) closePreview();
    });
    button.addEventListener('click', (event) => {
      // Position in the same task as opening so touch previews never flash at the viewport origin.
      event.preventDefault();
      if (hover.matches && event.detail > 0) {
        openPreview();
      } else if (preview.matches(':popover-open')) {
        closePreview();
      } else {
        openPreview();
      }
    });
    preview.addEventListener('beforetoggle', (event) => {
      const expanded = (event as ToggleEvent).newState === 'open';
      button.setAttribute('aria-expanded', String(expanded));
    });
    preview.addEventListener('toggle', positionPreview);
  }

  function closeOpenPreview() {
    document.querySelector<HTMLElement>('.newsletter-preview:popover-open')?.hidePopover();
  }
  // Top-layer popovers escape the scrolling day panel and close when it moves.
  document.querySelectorAll('.day-newsletters').forEach((list) => list.addEventListener('scroll', closeOpenPreview, { passive: true }));
  window.addEventListener('resize', closeOpenPreview);
  window.addEventListener('scroll', closeOpenPreview, { passive: true });
</script>
