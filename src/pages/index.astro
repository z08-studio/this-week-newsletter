---
import NewsletterCard from '../components/NewsletterCard.astro';
import { newsletters, weekdays } from '../data/newsletters';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main id="main" class="directory" aria-labelledby="directory-heading">
    <h1 id="directory-heading" class="sr-only">Your week in newsletters</h1>
    <div class="directory-toolbar">
      <p id="search-count" class="directory-count" role="status" aria-live="polite"><span class="count-dot" aria-hidden="true"></span><span data-count-text>{newsletters.length} newsletters. A week of good reads.</span></p>
      <div class="search-field">
        <label for="newsletter-search" class="sr-only">Search newsletters</label>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.5 4.5" /></svg>
        <input id="newsletter-search" type="search" placeholder="Find a newsletter…" autocomplete="off" />
        <span class="search-shortcut" aria-hidden="true">/</span>
      </div>
    </div>

    <div id="weekly-calendar" class="weekly-calendar" aria-label="Newsletters by publication day">
      {weekdays.map((day, dayIndex) => {
        const entries = newsletters.filter((newsletter) => newsletter.publicationDay === dayIndex);
        return (
          <section class:list={['day-column', { 'day-column--weekend': dayIndex === 0 || dayIndex === 6 }]} data-day-column data-empty={entries.length === 0 ? 'true' : 'false'} aria-labelledby={`day-${dayIndex}`}>
            <div class="day-heading">
              <h2 id={`day-${dayIndex}`}>{day}</h2>
              <span class:list={['day-count', { 'day-count--empty': entries.length === 0 }]} data-day-count aria-label={`${entries.length} newsletters`}>{entries.length || '—'}</span>
            </div>
            <ul class="day-newsletters">{entries.map((newsletter) => <NewsletterCard newsletter={newsletter} />)}</ul>
          </section>
        );
      })}
    </div>

    <div id="empty-state" class="empty-state" hidden>
      <span class="empty-icon" aria-hidden="true">⌕</span>
      <h2>No newsletters found.</h2>
      <p>Try another name, topic, or language.</p>
      <button class="text-button" id="clear-search" type="button">Show all newsletters <span aria-hidden="true">↗</span></button>
    </div>

    <div class="calendar-note">
      <p><span class="studio-key" aria-hidden="true"></span>Letters from our studio, alongside a few favorites.</p>
      <p>Publication days follow each newsletter’s usual schedule.</p>
    </div>
  </main>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('#newsletter-search');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-newsletter]'));
  const columns = Array.from(document.querySelectorAll<HTMLElement>('[data-day-column]'));
  const countText = document.querySelector<HTMLElement>('[data-count-text]');
  const calendar = document.querySelector<HTMLElement>('#weekly-calendar');
  const emptyState = document.querySelector<HTMLElement>('#empty-state');
  function filterNewsletters() {
    const query = search?.value.trim().toLocaleLowerCase() ?? '';
    let visibleCount = 0;
    for (const card of cards) {
      const matches = (card.dataset.search ?? '').includes(query);
      card.hidden = !matches;
      if (matches) visibleCount += 1;
    }
    for (const column of columns) {
      const visible = column.querySelectorAll('[data-newsletter]:not([hidden])').length;
      const counter = column.querySelector<HTMLElement>('[data-day-count]');
      if (counter) {
        counter.textContent = visible ? String(visible) : '—';
        counter.setAttribute('aria-label', `${visible} ${visible === 1 ? 'newsletter' : 'newsletters'}`);
        counter.classList.toggle('day-count--empty', visible === 0);
      }
      column.dataset.empty = visible === 0 ? 'true' : 'false';
    }
    if (countText) countText.textContent = query ? `${visibleCount} of ${cards.length} newsletters` : `${cards.length} newsletters. A week of good reads.`;
    if (calendar) calendar.hidden = visibleCount === 0;
    if (emptyState) emptyState.hidden = visibleCount > 0;
  }
  search?.addEventListener('input', filterNewsletters);
  document.querySelector('#clear-search')?.addEventListener('click', () => {
    if (search) search.value = '';
    filterNewsletters();
    search?.focus();
  });
  document.addEventListener('keydown', (event) => {
    const target = event.target;
    if (event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey && !(target instanceof HTMLElement && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)))) {
      event.preventDefault();
      search?.focus();
    }
  });
  window.addEventListener('pageshow', filterNewsletters);
  filterNewsletters();
</script>
