---
import { designDirections } from '../../data/designDirections';
import DesignLayout from '../../layouts/DesignLayout.astro';
---

<DesignLayout>
  <main id="main" class="design-gallery">
    <header class="gallery-heading">
      <div><p>This Week In Newsletters</p><h1>Five design directions.</h1></div>
      <p>Open a direction to explore it.<br />Switch between all five at the top.</p>
    </header>
    <div class="design-grid">
      {designDirections.map((direction) => (
        <article class="direction-card">
          <div class="direction-thumbnail">
            <div class="thumbnail-sizer"><iframe src={`/designs/${direction.id}/?embed=1`} title={`${direction.name} preview`} width="1280" height="820" tabindex="-1" aria-hidden="true" inert></iframe></div>
            <a class="thumbnail-link" href={`/designs/${direction.id}/`} aria-label={`Open ${direction.number} ${direction.name}`}><span>Explore this direction <span aria-hidden="true">↗</span></span></a>
          </div>
          <div class="direction-caption"><h2><span>{direction.number}</span> <a href={`/designs/${direction.id}/`}>{direction.name}</a></h2><p>{direction.description}</p></div>
        </article>
      ))}
    </div>
  </main>
</DesignLayout>

<script>
  const observer = new ResizeObserver((entries) => {
    for (const entry of entries) {
      const frame = entry.target.querySelector<HTMLElement>('.thumbnail-sizer');
      if (frame) frame.style.transform = `scale(${entry.contentRect.width / 1280})`;
    }
  });
  document.querySelectorAll('.direction-thumbnail').forEach((thumbnail) => observer.observe(thumbnail));
</script>
