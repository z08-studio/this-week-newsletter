---
import type { Newsletter } from '../data/newsletters';
interface Props { newsletter: Newsletter }
const { newsletter } = Astro.props;
const previewId = `preview-${newsletter.id}`;
---

<li class="newsletter-item" data-newsletter>
    <button class="newsletter-name" type="button" popovertarget={previewId} aria-controls={previewId} aria-expanded="false">
      <span class="newsletter-title" lang={newsletter.language === '中文' ? 'zh-CN' : 'en'}>{newsletter.name}</span>
      <span class="newsletter-toggle" aria-hidden="true">↗</span>
    </button>
    <div class="newsletter-preview" id={previewId} popover="auto" aria-label={`${newsletter.name} details`}>
      <p>{newsletter.description}</p>
      <p class="newsletter-meta"><span>{newsletter.language}</span><span>{newsletter.owned ? 'z08 Studio' : 'Independent'}</span></p>
      <a class="newsletter-visit" href={newsletter.url} target="_blank" rel="noopener noreferrer" aria-label={`Read ${newsletter.name} — opens in a new tab`}>Read newsletter <span aria-hidden="true">↗</span></a>
    </div>
</li>
