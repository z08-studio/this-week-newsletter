---
import { site } from '../data/site';
import ArrowIcon from './ArrowIcon.astro';
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <a class="studio-signature" href={site.studio.url} target="_blank" rel="noopener noreferrer" aria-label="Visit z08 Studio">
      <span>z08</span> Studio
    </a>
    <nav class="studio-links" aria-label="z08 Studio links">
      <a href={site.studio.url} target="_blank" rel="noopener noreferrer">Website<ArrowIcon /></a>
      <a href={site.repositoryUrl} target="_blank" rel="noopener noreferrer">GitHub<ArrowIcon /></a>
      <button class="cookie-settings" type="button" data-analytics-settings hidden>Cookie settings</button>
    </nav>
  </div>
</footer>
