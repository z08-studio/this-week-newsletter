---
import NewsletterCard from './NewsletterCard.astro';
import { newsletters, weekdays } from '../data/newsletters';
import { site } from '../data/site';
import type { DesignDirection } from '../data/designDirections';
interface Props { direction: DesignDirection }
const { direction } = Astro.props;
---

<div class={`concept concept--${direction.id}`}>
  <main id="main" class="concept-shell">
    <header class="concept-header">
      <a class="concept-brand" href="/" aria-label="This Week In Newsletters home">
        <span class="concept-mark" aria-hidden="true">
          <svg viewBox="0 0 64 64" fill="none"><path d="m12 20 8 23q2 6 5 0l7-14 7 14q3 6 5 0l8-23" stroke="currentColor" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
        <h1><span>This Week In</span><strong>Newsletters</strong></h1>
      </a>
      {site.submissionFormUrl && <a class="concept-submit" href={site.submissionFormUrl} target="_blank" rel="noopener noreferrer">Add to this site <span aria-hidden="true">↗</span></a>}
    </header>

    <div class="concept-board">
      {weekdays.map((day, index) => {
        const entries = newsletters.filter((newsletter) => newsletter.publicationDay === index);
        return (
          <section class="concept-day" data-empty={entries.length === 0 ? 'true' : 'false'} aria-labelledby={`day-${index}`}>
            <h2 class="concept-day-heading" id={`day-${index}`}>{day}</h2>
            <ul class="day-newsletters" aria-label={`${day} newsletters`} tabindex={entries.length ? 0 : undefined}>
              {entries.map((newsletter) => <NewsletterCard newsletter={newsletter} />)}
            </ul>
          </section>
        );
      })}
    </div>
  </main>
</div>

<script>
  import '../scripts/newsletterPreview';
</script>
