---
import { designDirections, type DesignDirection } from '../data/designDirections';
interface Props { direction: DesignDirection }
const { direction } = Astro.props;
---

<nav class="review-bar" aria-label="Design directions">
  <a class="review-back" href="/designs/">All designs <span aria-hidden="true">↗</span></a>
  <div class="review-tabs">{designDirections.map((item) => <a href={`/designs/${item.id}/`} aria-current={item.id === direction.id ? 'page' : undefined}><span>{item.number}</span> {item.name}</a>)}</div>
</nav>

<style>
  .review-bar { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 68px; padding: 12px 30px; color: #bbebc7; background: #581d30; font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; }
  .review-bar a { color: inherit; text-decoration: none; white-space: nowrap; }
  .review-back { display: inline-flex; align-items: center; gap: 14px; padding: 10px 0; }
  .review-tabs { display: flex; align-items: center; gap: 6px; overflow-x: auto; }
  .review-tabs a { display: block; padding: 10px 15px; border: 1px solid transparent; border-radius: 999px; }
  .review-tabs a span { margin-right: 7px; opacity: .7; }
  .review-tabs a:hover { border-color: #bbebc744; }
  .review-tabs a[aria-current='page'] { color: #581d30; background: #bbebc7; }
  :global(html[data-embed]) .review-bar { display: none; }
  @media (max-width: 900px) {
    .review-bar { position: static; flex-wrap: wrap; padding-inline: 20px; gap: 6px; }
    .review-tabs { width: 100%; }
  }
</style>
