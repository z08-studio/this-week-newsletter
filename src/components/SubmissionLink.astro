---
import { site } from '../data/site';
---
{site.submissionFormUrl ? (
  <a class="submit-button" href={site.submissionFormUrl} target="_blank" rel="noopener noreferrer">
    Add to this site<span aria-hidden="true">↗</span>
  </a>
) : (
  <button class="submit-button" type="button" data-open-submit>
    Add to this site<span aria-hidden="true">↗</span>
  </button>
)}
