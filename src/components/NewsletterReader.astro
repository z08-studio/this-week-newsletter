---
import { calendarOrder, newsletters, weekdays } from '../data/newsletters';
import { newsletterArchives } from '../data/newsletterArchives';
import ArrowIcon from './ArrowIcon.astro';
import BookGlyph from './BookGlyph.astro';

const initialDay = 3;
const readingPreviewCount = 5;
const days = calendarOrder.map(index => ({
  index, name: weekdays[index], slug: weekdays[index].toLowerCase(),
  entries: newsletters.filter(entry => entry.publicationDay === index),
}));
const formatDate = (date: string) => new Intl.DateTimeFormat('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${date}T12:00:00Z`));
const issueLabel = (title: string, publication: string) => title.toLowerCase().startsWith(publication.toLowerCase())
  ? title.slice(publication.length).replace(/^[\s:–—-]+/, '') || title
  : title;
---

    <aside class="day-details" aria-label="Newsletter reading panel">
      <p class="sr-only" role="status" aria-live="polite" data-day-status></p>
      {days.map((day) => {
        const hasMore = day.entries.length > readingPreviewCount;
        const listId = `reading-list-${day.slug}`;
        return (
          <section class="day-detail" id={`reading-${day.slug}`} data-day-panel={day.slug} hidden={day.index !== initialDay} aria-labelledby={`reading-title-${day.slug}`}>
            <h2 id={`reading-title-${day.slug}`} tabindex="-1">{day.name}</h2>
            <div
              id={listId}
              class:list={['reading-list', { 'reading-list-limited': hasMore }]}
              style={hasMore ? `--reading-preview-count: ${readingPreviewCount}` : undefined}
              role={hasMore ? 'region' : undefined}
              aria-label={hasMore ? `${day.name} newsletter list` : undefined}
              tabindex={hasMore ? 0 : undefined}
            >
              {day.entries.length ? (
                <ul>
                  {day.entries.map((entry, index) => {
                    const overflow = index >= readingPreviewCount;
                    return (
                      <li class="reading-item" data-reading-overflow={overflow || undefined} hidden={overflow}>
                        <button class="reading-entry" type="button" data-open-newsletter={entry.id} aria-label={`View details for ${entry.name}`} aria-controls={`newsletter-${entry.id}`}>
                          <BookGlyph class="reading-motif" />
                          <span class="reading-name" lang={entry.language === '中文' ? 'zh-CN' : 'en'}>{entry.name}</span>
                          <ArrowIcon />
                        </button>
                      </li>
                    );
                  })}
                </ul>
              ) : (
                <div class="empty-day">
                  <img src="/illustrations/open-book.webp" alt="" width="88" height="88" />
                  <p>A little room for a good read.</p>
                  <p>Have a newsletter for {day.name}? Suggest it using the link above.</p>
                </div>
              )}
            </div>
            {hasMore && (
              <button class="reading-list-toggle" type="button" aria-controls={listId} aria-expanded="false" data-reading-list-toggle>
                <span class="reading-list-more">Show all {day.entries.length} newsletters</span>
                <span class="reading-list-fewer">Show fewer newsletters</span>
                <span class="rail-arrow" aria-hidden="true"></span>
              </button>
            )}
          </section>
        );
      })}
      {newsletters.map((entry) => {
        const day = weekdays[entry.publicationDay];
        const archive = newsletterArchives[entry.id];
        const issues = archive?.issues.slice(0, 3) ?? [];
        const topics = entry.topics.filter((topic) => !/\p{Script=Han}/u.test(topic)).slice(0, 2);
        return (
          <section class="newsletter-detail" id={`newsletter-${entry.id}`} data-newsletter-panel={entry.id} data-publication-day={day.toLowerCase()} hidden aria-labelledby={`newsletter-title-${entry.id}`}>
            <button class="back-to-day" type="button" data-back-to-day={day.toLowerCase()}><span class="back-arrow" aria-hidden="true"></span>All {day} newsletters</button>
            <div class="detail-heading">
              <BookGlyph class="detail-motif" />
              <h2 id={`newsletter-title-${entry.id}`} tabindex="-1" lang={entry.language === '中文' ? 'zh-CN' : 'en'}>{entry.name}</h2>
            </div>
            <p class="detail-description">{entry.description}</p>
            <dl class="detail-facts">
              <div><dt class="sr-only">Usual day</dt><dd>{day}</dd></div>
              <div><dt class="sr-only">Language</dt><dd>{entry.language === '中文' ? 'Chinese' : 'English'}</dd></div>
              <div class="detail-topics"><dt class="sr-only">Topics</dt><dd>{topics.join(' / ')}</dd></div>
            </dl>
            <a class="publication-link" href={entry.url} target="_blank" rel="noopener noreferrer" data-newsletter-id={entry.id} data-newsletter-link="publication">Visit publication<ArrowIcon /></a>
            {issues.length > 0 && (
              <section class="recent-issues" aria-labelledby={`issues-title-${entry.id}`}>
                <h3 id={`issues-title-${entry.id}`}>Past issues</h3>
                <ol>
                  {issues.map((issue) => (
                    <li><a href={issue.url} target="_blank" rel="noopener noreferrer" title={issue.title} aria-label={`${issue.title}${issue.publishedAt ? `, ${formatDate(issue.publishedAt)}` : ''}`} data-newsletter-id={entry.id} data-newsletter-link="issue">
                      <span class="issue-copy">
                        <span class="issue-title">{issueLabel(issue.title, entry.name)}</span>
                        {issue.publishedAt && <time datetime={issue.publishedAt}>{formatDate(issue.publishedAt)}</time>}
                      </span>
                      <ArrowIcon />
                    </a></li>
                  ))}
                </ol>
              </section>
            )}
            {archive?.archiveUrl && <a class="archive-link" href={archive.archiveUrl} target="_blank" rel="noopener noreferrer" data-newsletter-id={entry.id} data-newsletter-link="archive">{archive.archiveLabel ?? 'Browse the archive'}<ArrowIcon /></a>}
          </section>
        );
      })}
    </aside>

    <div class="issue-drawer-backdrop" data-issue-backdrop hidden></div>
    <aside class="issue-drawer" id="issue-reader-drawer" aria-label="Issue reader" data-issue-drawer hidden tabindex="-1">
      <header class="issue-drawer-header">
        <div class="issue-drawer-bar">
          <button type="button" class="issue-drawer-close" data-close-issue-drawer aria-label="Close issue reader">
            <span class="back-arrow" aria-hidden="true"></span>
            <span>Close reader</span>
          </button>
          <a class="issue-drawer-external" href="#" target="_blank" rel="noopener noreferrer" data-issue-external>
            <span>Read on original site</span>
            <ArrowIcon />
          </a>
        </div>
        <div class="issue-drawer-meta">
          <p class="issue-drawer-pub" data-issue-pub></p>
          <h2 class="issue-drawer-title" data-issue-title tabindex="-1"></h2>
          <p class="issue-drawer-date" data-issue-date hidden></p>
        </div>
      </header>
      <div class="issue-drawer-body" data-issue-body></div>
    </aside>
