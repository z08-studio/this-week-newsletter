{
	auto_https off
	persist_config off
}

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

:8080 {
	root * /srv/releases/current
	encode zstd gzip
	import security_headers
	@liveIssues {
		path /data/recent-issues.json /data/issues/*
		file {
			root /srv
		}
	}
	handle @liveIssues {
		root * /srv
		header Cache-Control "public, max-age=300"
		file_server
	}
	@pages not path /_astro/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Retired design studies have a single canonical destination.
	@legacy path /designs /designs/*
	redir @legacy / 301
	file_server
	handle_errors 404 {
		import security_headers
		header Cache-Control "no-store"
		rewrite * /404.html
		file_server
	}
}
